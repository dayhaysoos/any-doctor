---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import ScanDemo from "../components/ScanDemo.astro";
import TrustedBy from "../components/TrustedBy.astro";
import ValueSections from "../components/ValueSections.astro";
import Faq from "../components/Faq.astro";
import { config } from "virtual:nimbus/config";
import { withBase } from "@cloudflare/nimbus-docs/runtime";

// Prerender explicitly so the homepage stays a static route under
// `output: "server"` — an adapter alone must add zero on-demand routes.
export const prerender = true;
---

<BaseLayout title={config.title} description={config.description}>
  <div class="flex flex-col min-h-screen">
    <Header />
    <main id="main-content" tabindex="-1" class="flex-1 mx-auto max-w-3xl w-full px-6 py-24">
      <h1
        class="text-foreground leading-tight"
        style="font-size: var(--nb-h1-size); font-weight: var(--nb-h1-weight); letter-spacing: var(--nb-h1-tracking);"
      >
        Capture your AI's mistakes.<br />
        Report them to your doctor.
      </h1>
      <p class="mt-4 text-[0.9375rem] text-muted-foreground leading-relaxed">
        A <strong class="text-foreground font-medium">doctor</strong> finds the
        mistakes your AI keeps making. Run it after your agent is done. Save
        yourself from burning tokens catching the same mistakes in review.
        Create your own doctor for you and your team.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-stretch">
        <div
          class="flex items-center gap-3 rounded-lg border border-border bg-card px-4 py-3 sm:min-w-0"
        >
          <span class="text-muted-foreground select-none" aria-hidden="true">$</span>
          <code class="text-sm text-foreground whitespace-nowrap">npx any-doctor@latest</code>
          <button
            type="button"
            data-copy="npx any-doctor@latest"
            class="ml-auto shrink-0 rounded-md border border-border px-2.5 py-1 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground hover:border-border-strong"
          >
            Copy
          </button>
        </div>
        <a
          href="https://github.com/dayhaysoos/any-doctor"
          target="_blank"
          rel="noopener"
          class="flex items-center justify-center gap-2 rounded-lg border border-border px-4 py-3 text-sm font-medium text-foreground no-underline transition-colors hover:border-border-strong"
        >
          <svg viewBox="0 0 16 16" class="w-4 h-4 fill-current" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
          </svg>
          GitHub
        </a>
        <a
          href={withBase("/welcome", import.meta.env.BASE_URL)}
          class="flex items-center justify-center rounded-lg border border-border px-4 py-3 text-sm font-medium text-foreground no-underline transition-colors hover:border-border-strong"
        >
          Read the docs
        </a>
      </div>

      <ScanDemo />

      <TrustedBy />

      <ValueSections />

      <Faq />
    </main>
  </div>
</BaseLayout>

<script>
  function bindCopyButtons() {
    for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
      if (btn.dataset.bound) continue;
      btn.dataset.bound = "1";
      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        } catch {
          // Clipboard needs a secure context (localhost counts); fail quietly.
          return;
        }
        const original = btn.textContent;
        btn.textContent = "Copied";
        setTimeout(() => { btn.textContent = original; }, 1500);
      });
    }
  }
  document.addEventListener("astro:page-load", bindCopyButtons);
</script>
