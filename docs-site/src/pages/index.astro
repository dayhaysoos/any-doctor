---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import ScanDemo from "../components/ScanDemo.astro";
import TrustedBy from "../components/TrustedBy.astro";
import ValueSections from "../components/ValueSections.astro";
import Faq from "../components/Faq.astro";
import { config } from "virtual:nimbus/config";
import { withBase } from "@cloudflare/nimbus-docs/runtime";

// Prerender explicitly so the homepage stays a static route under
// `output: "server"` — an adapter alone must add zero on-demand routes.
export const prerender = true;
---

<BaseLayout title={config.title} description={config.description}>
  <div class="flex flex-col min-h-screen">
    <Header />
    <main id="main-content" tabindex="-1" class="flex-1 mx-auto max-w-3xl w-full px-6 py-24">
      <h1
        class="text-foreground"
        style="font-size: clamp(1.75rem, 4vw, 2.125rem); font-weight: 560; line-height: 1.3; letter-spacing: -0.02em; text-wrap: balance;"
      >
        Stop wasting time and money catching mistakes your agents keep repeating.
      </h1>
      <p class="mt-5 max-w-[68ch] text-[1rem] text-muted-foreground leading-relaxed">
        Agents keep making the same mistakes, then spend code review finding
        them again. Turn those findings into deterministic checks. Known issues
        get caught before review, so your agents can focus on harder problems.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-stretch">
        <div
          class="flex items-center gap-3 rounded-lg border border-border bg-card px-4 py-3 sm:min-w-0"
        >
          <span class="text-muted-foreground select-none" aria-hidden="true">$</span>
          <code class="text-sm text-foreground whitespace-nowrap">npx any-doctor@latest</code>
          <button
            type="button"
            data-copy="npx any-doctor@latest"
            class="ml-auto shrink-0 rounded-md border border-border px-2.5 py-1 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground hover:border-border-strong"
          >
            Copy
          </button>
        </div>
        <a
          href={withBase("/authoring/first-doctor", import.meta.env.BASE_URL)}
          class="flex items-center justify-center rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground no-underline transition-colors hover:bg-primary-hover"
        >
          Write your first doctor
        </a>
      </div>

      <ScanDemo />

      <TrustedBy />

      <ValueSections />

      <Faq />

      <div class="mt-20 flex flex-col items-center gap-4 border-t border-border pt-14 pb-6 text-center">
        <h2 class="max-w-xl text-2xl font-bold tracking-[-0.03em] text-foreground text-balance">What did your agent get wrong twice?</h2>
        <p class="max-w-xl text-muted-foreground leading-relaxed">That is probably your first doctor.</p>
        <div class="mt-2 flex flex-wrap justify-center gap-3">
          <a
            href={withBase("/authoring/first-doctor", import.meta.env.BASE_URL)}
            class="rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground no-underline transition-colors hover:bg-primary-hover"
          >
            Write your first doctor
          </a>
          <a
            href={withBase("/welcome", import.meta.env.BASE_URL)}
            class="rounded-lg border border-border px-5 py-3 text-sm font-semibold text-foreground no-underline transition-colors hover:border-border-strong"
          >
            Read the docs
          </a>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>

<script>
  function bindCopyButtons() {
    for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
      if (btn.dataset.bound) continue;
      btn.dataset.bound = "1";
      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        } catch {
          // Clipboard needs a secure context (localhost counts); fail quietly.
          return;
        }
        const original = btn.textContent;
        btn.textContent = "Copied";
        setTimeout(() => { btn.textContent = original; }, 1500);
      });
    }
  }
  bindCopyButtons();
  document.addEventListener("astro:page-load", bindCopyButtons);
</script>
