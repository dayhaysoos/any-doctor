---
// A compact example of the core loop: a repeated review lesson becomes a
// doctor, the doctor catches the next occurrence, and the agent fixes it.
---

<section class="demo" data-demo aria-labelledby="demo-title">
  <div class="demo-heading">
    <div>
      <h2 id="demo-title">A review lesson your codebase remembers.</h2>
      <p>Here is one example: this team requires every request helper to accept and pass an AbortSignal.</p>
    </div>
    <button type="button" class="playback" data-playback aria-label="Pause example">
      <svg data-pause viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 3.5h2v9h-2zm5 0h2v9h-2z" fill="currentColor"/></svg>
      <svg data-play class="icon-hidden" viewBox="0 0 16 16" aria-hidden="true"><path d="m5 3 8 5-8 5z" fill="currentColor"/></svg>
    </button>
  </div>

  <div class="stage-nav" role="tablist" aria-label="Example stages">
    <button type="button" role="tab" aria-selected="true" aria-controls="stage-review" id="tab-review" data-stage-button="0">
      <span>Review says it</span><small>once again</small>
    </button>
    <button type="button" role="tab" aria-selected="false" aria-controls="stage-catch" id="tab-catch" data-stage-button="1" tabindex="-1">
      <span>Doctor catches it</span><small>every time</small>
    </button>
    <button type="button" role="tab" aria-selected="false" aria-controls="stage-fix" id="tab-fix" data-stage-button="2" tabindex="-1">
      <span>Agent fixes it</span><small>before review</small>
    </button>
  </div>

  <div class="window">
    <div class="window-bar" aria-hidden="true">
      <span></span><span></span><span></span>
      <strong>src/profile.ts</strong>
      <em>example team rule</em>
    </div>

    <div class="stage" role="tabpanel" id="stage-review" aria-labelledby="tab-review" data-stage="0">
      <pre><code><span class="dim">1  async function loadProfile(id) &#123;</span>
<span class="focus">2    const response = await fetch(`/api/users/$&#123;id&#125;`);</span>
<span class="dim">3    return response.json();</span>
<span class="dim">4  &#125;</span></code></pre>
      <aside>
        <p class="label">Review comment · again</p>
        <blockquote>“Request helpers must accept and pass an AbortSignal.”</blockquote>
        <p>Your team already knows this rule. The reviewer should not have to rediscover it on every change.</p>
      </aside>
    </div>

    <div class="stage" role="tabpanel" id="stage-catch" aria-labelledby="tab-catch" data-stage="1" hidden>
      <pre><code><span class="dim">1  async function loadProfile(id) &#123;</span>
<span class="flagged">2    const response = await fetch(`/api/users/$&#123;id&#125;`);</span>
<span class="dim">3    return response.json();</span>
<span class="dim">4  &#125;</span></code></pre>
      <aside>
        <p class="label">team-network/abort-signal-required</p>
        <h3>Request cannot be cancelled.</h3>
        <p>This helper does not accept or pass an AbortSignal.</p>
        <div class="facts"><span>local</span><span>deterministic</span><span>0 tokens</span></div>
      </aside>
    </div>

    <div class="stage" role="tabpanel" id="stage-fix" aria-labelledby="tab-fix" data-stage="2" hidden>
      <pre><code><span class="good">1  async function loadProfile(id, signal) &#123;</span>
<span class="good">2    const response = await fetch(</span>
<span class="good">3      `/api/users/$&#123;id&#125;`, &#123; signal &#125;</span>
<span class="good">4    );</span>
<span class="good">5    return response.json();</span>
<span class="good">6  &#125;</span></code></pre>
      <aside>
        <p class="label">Rescan</p>
        <div class="clean">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 10 3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <strong>Finding resolved</strong>
        </div>
        <p>The same doctor runs on the next agent change. Broad review stays focused on what is new and difficult.</p>
      </aside>
    </div>
  </div>
</section>

<style>
  .demo { margin-top: 4rem; }
  .demo-heading { display: flex; align-items: end; justify-content: space-between; gap: 1.5rem; margin-bottom: 1.25rem; }
  h2 { max-width: 23ch; margin: 0; color: var(--color-foreground); font-size: clamp(1.45rem, 3vw, 2rem); line-height: 1.12; letter-spacing: -0.03em; font-weight: 700; text-wrap: balance; }
  .demo-heading p { max-width: 62ch; margin: 0.55rem 0 0; color: var(--color-muted-foreground); font-size: 0.94rem; line-height: 1.6; }
  .playback { display: grid; place-items: center; flex: none; width: 2.65rem; height: 2.65rem; border: 1px solid var(--color-border); border-radius: 0.65rem; color: var(--color-muted-foreground); background: transparent; cursor: pointer; transition: color 150ms ease, border-color 150ms ease; }
  .playback:hover { color: var(--color-foreground); border-color: var(--color-border-strong); }
  .playback:focus-visible, .stage-nav button:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }
  .playback svg { width: 0.9rem; height: 0.9rem; }
  .icon-hidden { display: none; }

  .stage-nav { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--color-border); border-bottom: 0; border-radius: 0.8rem 0.8rem 0 0; overflow: hidden; }
  .stage-nav button { min-width: 0; padding: 0.8rem 0.9rem; border: 0; border-right: 1px solid var(--color-border); background: var(--color-muted); color: var(--color-muted-foreground); text-align: left; cursor: pointer; }
  .stage-nav button:last-child { border-right: 0; }
  .stage-nav button[aria-selected="true"] { background: var(--color-card); color: var(--color-foreground); box-shadow: inset 0 -2px var(--color-primary); }
  .stage-nav span, .stage-nav small { display: block; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .stage-nav span { font-size: 0.82rem; font-weight: 700; }
  .stage-nav small { margin-top: 0.1rem; font-size: 0.7rem; }

  .window { overflow: hidden; border: 1px solid #2a3039; border-radius: 0 0 0.8rem 0.8rem; background: #0b0d12; box-shadow: 0 20px 48px -24px rgb(0 0 0 / 0.55); }
  .window-bar { min-height: 2.55rem; display: flex; align-items: center; gap: 0.38rem; padding: 0 0.9rem; border-bottom: 1px solid #252a33; color: #aeb8c6; font: 0.7rem/1 var(--nb-font-mono); }
  .window-bar > span { width: 0.58rem; height: 0.58rem; border-radius: 50%; background: #4a5260; }
  .window-bar strong { margin-left: 0.4rem; color: #e8edf4; font-weight: 600; }
  .window-bar em { margin-left: auto; font-style: normal; }
  .stage { min-height: 20rem; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(15rem, 0.8fr); }
  .stage[hidden] { display: none; }
  .stage.entering { animation: stage-in 360ms cubic-bezier(0.16, 1, 0.3, 1) both; }
  @keyframes stage-in { from { opacity: 0; clip-path: inset(0 0 7% 0); transform: translateY(6px); } }
  pre { min-width: 0; margin: 0; padding: 1.35rem; overflow-x: auto; border-right: 1px solid #252a33; color: #eef2f7; font: 500 clamp(0.71rem, 1.35vw, 0.84rem)/1.85 var(--nb-font-mono); }
  code { display: block; width: max-content; min-width: 100%; }
  code span { display: block; box-sizing: border-box; min-height: 1.85em; padding: 0 0.45rem; border-radius: 0.25rem; white-space: pre; }
  .dim { color: #b8c1ce; }
  .focus { color: #fff0d1; background: rgb(245 166 35 / 0.1); }
  .flagged { color: #ffe2ad; background: rgb(245 166 35 / 0.13); text-decoration: underline wavy #f5a623 1px; text-underline-offset: 0.3em; }
  .good { color: #c7f7e4; background: rgb(52 211 153 / 0.08); }
  aside { display: flex; flex-direction: column; justify-content: center; padding: 1.5rem; color: #d7dee8; }
  aside p { margin: 0; color: #bdc7d4; font-size: 0.88rem; line-height: 1.65; }
  .label { margin-bottom: 0.7rem !important; color: #79d9b2 !important; font: 700 0.68rem/1.4 var(--nb-font-mono) !important; text-transform: uppercase; letter-spacing: 0.03em; }
  blockquote { margin: 0 0 1rem; color: #fff; font-size: clamp(1.05rem, 2.2vw, 1.35rem); font-weight: 650; line-height: 1.3; letter-spacing: -0.02em; }
  aside h3 { margin: 0 0 0.55rem; color: #fff; font-size: 1.2rem; letter-spacing: -0.02em; }
  .facts { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 1rem; }
  .facts span { border: 1px solid #3a4351; border-radius: 999px; padding: 0.28rem 0.5rem; color: #d1d8e2; font: 0.64rem/1 var(--nb-font-mono); }
  .clean { display: flex; align-items: center; gap: 0.55rem; margin-bottom: 0.9rem; color: #7ee2bc; font-size: 1.2rem; }
  .clean svg { width: 1.25rem; height: 1.25rem; }

  @media (max-width: 640px) {
    .demo { margin-top: 3.25rem; }
    .stage-nav button { padding: 0.75rem 0.45rem; text-align: center; }
    .stage-nav small { display: none; }
    .stage { min-height: 32rem; grid-template-columns: 1fr; align-content: start; }
    pre { border-right: 0; border-bottom: 1px solid #252a33; padding: 1rem; overflow-x: hidden; }
    code { width: 100%; }
    code span { white-space: pre-wrap; overflow-wrap: anywhere; }
    aside { min-height: 13rem; padding: 1.2rem; }
    .window-bar em { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .stage { animation: none; } }
</style>

<script>
  const DURATION = 4200;

  function bindDemo(root: HTMLElement) {
    if (root.dataset.bound) return;
    root.dataset.bound = "true";
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-stage-button]"));
    const stages = Array.from(root.querySelectorAll<HTMLElement>("[data-stage]"));
    const playback = root.querySelector<HTMLButtonElement>("[data-playback]")!;
    const pauseIcon = root.querySelector<SVGElement>("[data-pause]")!;
    const playIcon = root.querySelector<SVGElement>("[data-play]")!;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let index = 0;
    let playing = !reduced;
    let timer: number | undefined;

    const updateControl = () => {
      playback.setAttribute("aria-label", playing ? "Pause example" : "Play example");
      pauseIcon.classList.toggle("icon-hidden", !playing);
      playIcon.classList.toggle("icon-hidden", playing);
    };
    const schedule = () => {
      if (timer !== undefined) window.clearTimeout(timer);
      if (playing && !document.hidden) timer = window.setTimeout(() => show((index + 1) % stages.length), DURATION);
    };
    const show = (next: number, focus = false) => {
      index = next;
      stages.forEach((stage, i) => {
        const active = i === index;
        stage.hidden = !active;
        stage.classList.toggle("entering", active && !reduced);
      });
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.setAttribute("aria-selected", String(active));
        tab.tabIndex = active ? 0 : -1;
      });
      if (focus) tabs[index].focus();
      schedule();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => { playing = false; updateControl(); show(i); });
      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
        event.preventDefault();
        playing = false;
        updateControl();
        show((i + (event.key === "ArrowRight" ? 1 : stages.length - 1)) % stages.length, true);
      });
    });
    playback.addEventListener("click", () => { playing = !playing; updateControl(); schedule(); });
    document.addEventListener("visibilitychange", schedule);
    updateControl();
    show(0);
  }

  function bindDemos() {
    document.querySelectorAll<HTMLElement>("[data-demo]").forEach(bindDemo);
  }
  bindDemos();
  document.addEventListener("astro:page-load", bindDemos);
</script>
