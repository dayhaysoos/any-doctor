---
// PROTOTYPE: A deliberately minimal visualization of authored Doctor rules
// scanning one repository. Disposable until the idea is proven.
---

<section class="scan-demo" data-scan-demo aria-labelledby="scan-demo-title">
  <header class="demo-heading">
    <p>Your rules. Every file.</p>
    <h2 id="scan-demo-title">Scan the whole codebase at once.</h2>
  </header>

  <div class="scan-card">
    <div class="card-bar">
      <span><i aria-hidden="true"></i> your-repo/</span>
      <div class="severity-legend" aria-hidden="true"><span>critical</span><span>warning</span></div>
    </div>

    <div class="tree-stage">
      <div class="scan-heading" aria-hidden="true">
        <span class="scan-index" data-scan-index>SCAN 01 / 03</span>
        <div class="scan-carousel"><span data-scan-label>SECURITY RULES</span></div>
        <i></i>
      </div>

      <div class="tree-wrap">
        <div class="scan-sweep" aria-hidden="true"></div>
        <div class="repo-tree" role="img" aria-label="A terminal-style repository tree. Authored security, code-convention, and architecture rules scan every branch and reveal warnings and critical findings.">
          <div class="tree-row root" data-row><span class="tree-glyph">◆</span><strong>src/</strong></div>
          <div class="tree-row folder" data-row><span class="tree-glyph">├──</span><strong>routes/</strong></div>
          <div class="tree-row file" data-row data-security="critical" data-architecture="warning"><span class="tree-glyph">│   ├──</span><span>account.ts</span><i data-marker>!</i></div>
          <div class="tree-row file" data-row data-conventions="warning"><span class="tree-glyph">│   ├──</span><span>profile.ts</span><i data-marker>!</i></div>
          <div class="tree-row file" data-row data-conventions="warning" data-architecture="critical"><span class="tree-glyph">│   └──</span><span>settings.ts</span><i data-marker>!</i></div>

          <div class="tree-row folder" data-row><span class="tree-glyph">├──</span><strong>handlers/</strong></div>
          <div class="tree-row file" data-row data-conventions="warning"><span class="tree-glyph">│   ├──</span><span>account.ts</span><i data-marker>!</i></div>
          <div class="tree-row file" data-row data-security="warning"><span class="tree-glyph">│   ├──</span><span>admin.ts</span><i data-marker>!</i></div>
          <div class="tree-row file" data-row data-architecture="warning"><span class="tree-glyph">│   └──</span><span>billing.ts</span><i data-marker>!</i></div>

          <div class="tree-row folder" data-row><span class="tree-glyph">└──</span><strong>jobs/</strong></div>
          <div class="tree-row file" data-row data-architecture="warning"><span class="tree-glyph">    ├──</span><span>sync-profile.ts</span><i data-marker>!</i></div>
          <div class="tree-row file" data-row data-security="critical"><span class="tree-glyph">    ├──</span><span>export-account.ts</span><i data-marker>!</i></div>
          <div class="tree-row file" data-row data-conventions="warning"><span class="tree-glyph">    └──</span><span>cleanup.ts</span><i data-marker>!</i></div>
        </div>
      </div>

      <div class="scan-result is-scanning" data-scan-result aria-live="polite">
        <strong data-result-count>0</strong>
        <span data-result-label>findings</span>
      </div>
    </div>
  </div>
</section>

<style>
  .scan-demo { margin-top: 4rem; }
  .demo-heading { margin: 0 auto 1.25rem; text-align: center; }
  .demo-heading p { margin: 0 0 0.45rem; color: var(--color-primary); font: 700 0.68rem/1.4 var(--nb-font-mono); letter-spacing: 0.1em; text-transform: uppercase; }
  .demo-heading h2 { margin: 0; color: var(--color-foreground); font-size: clamp(1.45rem, 3vw, 2rem); font-weight: 630; line-height: 1.2; letter-spacing: -0.03em; }
  .scan-card { overflow: hidden; border: 1px solid #29313c; border-radius: 0.9rem; color: #e8edf3; background: #090d12; box-shadow: 0 22px 52px -34px rgb(0 0 0 / 0.78); }
  .card-bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 3.1rem; padding: 0.55rem 0.85rem; border-bottom: 1px solid #252d37; background: #0e131a; }
  .card-bar > span { display: flex; align-items: center; gap: 0.55rem; color: #a9b3c0; font: 600 0.66rem/1 var(--nb-font-mono); }
  .card-bar i { width: 0.42rem; height: 0.42rem; border-radius: 50%; background: #69dbae; box-shadow: 0 0 11px rgb(105 219 174 / 0.65); }
  .severity-legend { display: flex; gap: 0.8rem; color: #788592; font: 600 0.52rem/1 var(--nb-font-mono); }
  .severity-legend span { display: flex; align-items: center; gap: 0.35rem; }
  .severity-legend span::before { width: 0.4rem; height: 0.4rem; border-radius: 50%; background: #ff6577; box-shadow: 0 0 7px rgb(255 101 119 / 0.4); content: ""; }
  .severity-legend span:last-child::before { background: #f2b95e; box-shadow: 0 0 7px rgb(242 185 94 / 0.35); }
  .tree-stage { position: relative; min-height: 31.5rem; padding: 1.4rem 1.2rem 4.8rem; background: radial-gradient(circle at 50% 18%, rgb(30 55 46 / 0.48), transparent 34%), #090d12; }
  .scan-heading { width: min(100%, 24rem); margin: 0 auto 1.15rem; color: #dff8ec; font-family: var(--nb-font-mono); }
  .scan-index { display: block; margin-bottom: 0.32rem; color: #65776f; font-size: 0.5rem; font-weight: 700; letter-spacing: 0.14em; }
  .scan-carousel { height: 1.65rem; overflow: hidden; }
  .scan-carousel [data-scan-label] { display: block; color: #7be0b8; font-size: 1.12rem; font-weight: 650; line-height: 1.45rem; letter-spacing: 0.09em; text-shadow: 0 0 18px rgb(105 219 174 / 0.18); transition: opacity 260ms ease, transform 320ms cubic-bezier(.25,.8,.25,1); }
  .scan-carousel [data-scan-label].is-leaving { opacity: 0; transform: translateY(-120%); }
  .scan-carousel [data-scan-label].is-entering { opacity: 0; transform: translateY(120%); }
  .scan-carousel [data-scan-label].no-transition { transition: none; }
  .scan-heading > i { display: block; width: 100%; height: 1px; margin-top: 0.5rem; background: linear-gradient(90deg, #447461, rgb(68 116 97 / 0.16), transparent); }
  .tree-wrap { position: relative; width: min(100%, 24rem); margin: 0 auto; }
  .scan-sweep { position: absolute; z-index: 3; top: -0.25rem; bottom: -0.25rem; left: -1.8rem; width: 1.8rem; pointer-events: none; opacity: 0; background: linear-gradient(to right, transparent 0%, rgb(105 219 174 / 0.05) 28%, rgb(105 219 174 / 0.48) 49%, rgb(105 219 174 / 0.1) 56%, transparent 100%); filter: drop-shadow(0 0 8px rgb(105 219 174 / 0.38)); }
  .scan-demo.is-scanning .scan-sweep { animation: sweep-tree 1350ms linear forwards; }
  .repo-tree { display: grid; width: min(100%, 24rem); margin: 0 auto; }
  .tree-row { position: relative; z-index: 2; display: grid; grid-template-columns: 5.5rem max-content 1rem; align-items: center; column-gap: 0.6rem; min-height: 1.55rem; color: #8e9ba8; font: 0.71rem/1.2 var(--nb-font-mono); opacity: 0.68; transition: color 420ms ease, opacity 420ms ease, text-shadow 420ms ease; }
  .tree-row.file { grid-template-columns: 7rem max-content 1rem; }
  .tree-row strong { color: #d5dde6; font-weight: 650; transition: color 420ms ease; }
  .tree-glyph { color: #556573; white-space: pre; transition: color 420ms ease, text-shadow 420ms ease; }
  .tree-row.root { grid-template-columns: 1.5rem max-content 1rem; margin-bottom: 0.12rem; }
  .tree-row.root .tree-glyph { color: #69dbae; }
  .tree-row > i { display: grid; width: 1rem; height: 1rem; place-items: center; border: 1px solid currentColor; border-radius: 50%; color: inherit; font-size: 0.58rem; font-style: normal; opacity: 0; transform: scale(0.4); transition: opacity 320ms ease, transform 420ms cubic-bezier(.2,.8,.2,1), background 320ms ease; }
  .tree-row.is-scanned { opacity: 0.5; }
  .tree-row.severity-warning { color: #f2bd66; opacity: 1; text-shadow: 0 0 10px rgb(242 185 94 / 0.18); }
  .tree-row.severity-critical { color: #ff7181; opacity: 1; text-shadow: 0 0 11px rgb(255 101 119 / 0.22); }
  .tree-row.severity-warning .tree-glyph,
  .tree-row.severity-warning > i { color: #f2bd66; }
  .tree-row.severity-critical .tree-glyph,
  .tree-row.severity-critical > i { color: #ff7181; }
  .tree-row.severity-warning > i,
  .tree-row.severity-critical > i { opacity: 1; transform: scale(1); }
  .tree-row.severity-warning > i { color: #241703; background: #f2b95e; }
  .tree-row.severity-critical > i { color: #27070c; background: #ff6577; }
  .scan-result { position: absolute; right: 0; bottom: 1.15rem; left: 0; display: flex; min-height: 2.8rem; align-items: baseline; justify-content: center; gap: 0.5rem; margin: auto; opacity: 1; transition: opacity 180ms ease; }
  .scan-result.is-scanning { opacity: 0; }
  .scan-result strong { color: #f2bd66; font: 650 2.25rem/1 var(--nb-font-mono); letter-spacing: -0.06em; text-shadow: 0 0 18px rgb(242 185 94 / 0.15); }
  .scan-result > span { color: #aeb9c3; font: 650 0.62rem/1 var(--nb-font-mono); letter-spacing: 0.12em; text-transform: uppercase; }
  .scan-result.is-updating strong { animation: result-pulse 320ms ease-out; }
  @keyframes sweep-tree {
    0% { left: -1.8rem; opacity: 0; }
    7% { opacity: 1; }
    93% { opacity: 1; }
    100% { left: 100%; opacity: 0; }
  }
  @keyframes result-pulse { 50% { color: #ffe0a6; transform: translateY(-2px); } }
  @media (max-width: 640px) {
    .scan-demo { margin-top: 3rem; }
    .demo-heading { text-align: left; }
    .tree-stage { min-height: 29.5rem; padding: 1.1rem 0.8rem 4.6rem; }
    .scan-heading, .tree-wrap, .repo-tree { width: min(100%, 20rem); }
    .scan-carousel [data-scan-label] { font-size: 1rem; }
    .tree-row { grid-template-columns: 4.65rem max-content 1rem; font-size: 0.64rem; }
    .tree-row.file { grid-template-columns: 5.85rem max-content 1rem; }
    .scan-result { bottom: 0.8rem; }
    .scan-result strong { font-size: 2rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .scan-carousel [data-scan-label], .tree-row, .tree-row strong, .tree-glyph, .tree-row > i { transition: none; }
    .scan-demo.is-scanning .scan-sweep { animation: none; }
    .scan-result.is-updating strong { animation: none; }
  }
</style>

<script>
  const demos = document.querySelectorAll<HTMLElement>('[data-scan-demo]');
  for (const demo of demos) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const rows = [...demo.querySelectorAll<HTMLElement>('[data-row]')];
    const scanLabel = demo.querySelector<HTMLElement>('[data-scan-label]');
    const scanIndex = demo.querySelector<HTMLElement>('[data-scan-index]');
    const result = demo.querySelector<HTMLElement>('[data-scan-result]');
    const resultCount = demo.querySelector<HTMLElement>('[data-result-count]');
    const resultLabel = demo.querySelector<HTMLElement>('[data-result-label]');
    const categories = [
      { key: 'security', label: 'SECURITY RULES' },
      { key: 'conventions', label: 'CODE CONVENTIONS' },
      { key: 'architecture', label: 'ARCHITECTURE RULES' },
    ] as const;
    let timers: number[] = [];
    let visible = false;
    let categoryIndex = 0;

    const schedule = (callback: () => void, delay: number) => {
      timers.push(window.setTimeout(callback, delay));
    };
    const clearTimers = () => {
      timers.forEach((timer) => window.clearTimeout(timer));
      timers = [];
    };
    const clearRows = () => {
      rows.forEach((row) => row.classList.remove('is-active', 'is-scanned', 'severity-warning', 'severity-critical'));
    };
    const setResult = (count: number, scanning = false) => {
      if (resultCount) resultCount.textContent = scanning ? '' : String(count);
      if (resultLabel) resultLabel.textContent = scanning ? '' : count === 1 ? 'finding' : 'findings';
      result?.classList.toggle('is-scanning', scanning);
      result?.classList.remove('is-updating');
      if (!scanning) {
        void result?.offsetWidth;
        result?.classList.add('is-updating');
      }
    };
    const setLabel = (label: string) => {
      if (scanLabel) scanLabel.textContent = label;
      if (scanIndex) scanIndex.textContent = `SCAN ${String(categoryIndex + 1).padStart(2, '0')} / ${String(categories.length).padStart(2, '0')}`;
    };
    const severityFor = (row: HTMLElement, key: string) => row.getAttribute(`data-${key}`);
    const showStatic = () => {
      clearTimers();
      demo.classList.remove('is-scanning');
      scanLabel?.classList.remove('is-leaving', 'is-entering', 'no-transition');
      clearRows();
      const category = categories[categoryIndex];
      setLabel(category.label);
      let findings = 0;
      rows.forEach((row) => {
        row.classList.add('is-scanned');
        const severity = severityFor(row, category.key);
        if (severity) {
          findings += 1;
          row.classList.add(`severity-${severity}`);
        }
      });
      setResult(findings);
    };

    const run = () => {
      clearTimers();
      if (reduceMotion.matches) {
        showStatic();
        return;
      }
      if (document.hidden || !visible) return;
      const category = categories[categoryIndex];
      setLabel(category.label);
      scanLabel?.classList.remove('is-leaving', 'is-entering', 'no-transition');
      clearRows();
      setResult(0, true);
      void demo.offsetWidth;
      demo.classList.add('is-scanning');

      const scanDuration = 1350;
      schedule(() => {
        demo.classList.remove('is-scanning');
        let findings = 0;
        rows.forEach((row) => {
          row.classList.add('is-scanned');
          const severity = severityFor(row, category.key);
          if (severity) {
            findings += 1;
            row.classList.add(`severity-${severity}`);
          }
        });
        setResult(findings);
        schedule(() => {
          scanLabel?.classList.add('is-leaving');
          clearRows();
          schedule(() => {
            categoryIndex = (categoryIndex + 1) % categories.length;
            scanLabel?.classList.add('no-transition');
            scanLabel?.classList.remove('is-leaving');
            scanLabel?.classList.add('is-entering');
            setLabel(categories[categoryIndex].label);
            void scanLabel?.offsetWidth;
            scanLabel?.classList.remove('no-transition');
            schedule(() => scanLabel?.classList.remove('is-entering'), 20);
          }, 280);
          schedule(run, 850);
        }, 3400);
      }, scanDuration);
    };

    const stop = () => {
      clearTimers();
      demo.classList.remove('is-scanning');
    };
    reduceMotion.addEventListener('change', () => { if (reduceMotion.matches) showStatic(); else run(); });
    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); else run(); });
    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) run(); else stop();
    }, { threshold: 0.35 });
    observer.observe(demo);
  }
</script>
