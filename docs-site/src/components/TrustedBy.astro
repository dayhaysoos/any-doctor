---
const tools = ["Apple", "GitHub", "Cloudflare", "Anthropic", "Convex", "Effect", "OpenRouter", "React", "npm", "Motion", "Astro", "Tailwind"];
---

<aside class="trusted" aria-labelledby="trusted-title">
  <p id="trusted-title"><strong>Trusted by one guy.</strong> <span>Yes, that is the whole list.</span></p>
  <p class="setup">He uses it around:</p>
  <div class="tools" aria-label="Tools used by that one guy">
    {tools.map((name) => <span>{name}</span>)}
  </div>
</aside>

<style>
  .trusted { margin-top: 2.5rem; padding: 2rem 0; border-block: 1px solid var(--color-border); text-align: center; }
  .trusted p { margin: 0; }
  .trusted > p:first-child { color: var(--color-foreground); font-size: clamp(1.2rem, 2.5vw, 1.55rem); }
  .trusted strong { font-weight: 780; }
  .trusted > p:first-child span { color: var(--color-muted-foreground); }
  .setup { margin-top: 0.35rem !important; color: var(--color-muted-foreground); font-size: 0.88rem; }
  .tools { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.45rem 1rem; margin-top: 1rem; color: var(--color-muted-foreground); font: 600 0.78rem/1.5 var(--nb-font-mono); }
  .tools span { position: relative; }
  .tools span:not(:last-child)::after { content: "·"; position: absolute; left: calc(100% + 0.45rem); color: var(--color-border-strong); }
  @media (max-width: 520px) {
    .tools { gap: 0.4rem 0.85rem; }
    .tools span:not(:last-child)::after { left: calc(100% + 0.36rem); }
  }
</style>
