{
  "name": "any-doctor",
  "version": "0.1.0",
  "description": "Your agent writes the analyzer, fixtures prove it, CI reruns it forever.",
  "license": "MIT",
  "bin": {
    "any-doctor": "bin/cli.js"
  },
  "types": "./bin/contract.d.ts",
  "exports": {
    ".": {
      "types": "./bin/contract.d.ts",
      "default": "./bin/contract.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');['bin/cli.js','bin/doctor-loader.mjs'].forEach(f=>fs.chmodSync(f,0o755))\"",
    "prepublishOnly": "npm run build && npm test",
    "pretest": "npm run build",
    "test": "node --test"
  },
  "files": [
    "bin",
    "doctors",
    "fixtures",
    "skill",
    "docs",
    "CONTEXT.md",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxc-parser": "^0.149.0",
    "typescript": "^5.6.0"
  },
  "type": "module",
  "dependencies": {
    "@ast-grep/cli": "^0.45.3",
    "@typescript-eslint/scope-manager": "^8.70.0",
    "effect": "^4.0.0-beta.107",
    "eslint-scope": "^9.1.2",
    "eslint-visitor-keys": "^5.0.1"
  },
  "optionalDependencies": {
    "oxc-parser": "^0.149.0"
  }
}
